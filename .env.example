# All optional. With none of these set the service runs fully locally:
# the LLM fallback falls back to a deterministic keyword stub.

# Enables the real Claude Haiku fallback. Without it, the stub is used.
ANTHROPIC_API_KEY=

# Routing dial: predictions at or above this confidence take the fast path.
# Default 0.75. See the README for why a fresh 50-row seed rarely clears it.
CONFIDENCE_THRESHOLD=

# Where LLM-labeled transactions accumulate for the next retrain.
# Default data/llm_labels.jsonl
FEEDBACK_LOG=
